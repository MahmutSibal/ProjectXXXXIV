# AppSukran API - local development template
# Never put real production secrets in this file.

JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__DefaultConnection=Server=(localdb)\\mssqllocaldb;Database=AppSukranDb;Trusted_Connection=True;TrustServerCertificate=True;
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__DatabaseName=AppSukranDb

SuperAdmin__Enabled=false
SuperAdmin__Name=Super Admin
SuperAdmin__Email=superadmin@example.local
SuperAdmin__Password=replace-for-local-development-only

WHATSAPP_SERVICE_TOKEN=replace-with-the-same-token-used-by-the-whatsapp-service
