# Production ortam değişkenleri (frontend Vercel'de, API MonsterASP'ta).
#
# Vercel'de bu değerler dosyadan DEĞİL, proje ayarlarındaki
# Settings > Environment Variables bölümünden girilir. Bu dosya yalnızca
# hangi değişkenlerin gerektiğini gösterir ve yerel "npm run build" içindir.

# API'nin tam adresi. Backend ayrı alan adında olduğu için göreli yol kullanılamaz.
#
# ÖNEMLİ: https olmalı. Vercel siteyi zorunlu olarak HTTPS sunar; HTTPS bir sayfadan
# HTTP bir adrese istek atılamaz, tarayıcı sessizce engeller (mixed content).
# Bunun için MonsterASP panelinden HTTPS (Let's Encrypt) açılmış olmalı.
VITE_API_BASE_URL=https://mahmutapp.tryasp.net/api

# Masa QR kodlarına GÖMÜLEN adres — müşteri menüsünün açılacağı yer, yani FRONTEND adresi.
# Backend adresi DEĞİLDİR.
#
# DİKKAT: Yanlış olursa basılmış QR kodları çalışmaz. Vercel alan adınız kesinleşmeden
# masa QR kodu bastırmayın. Kendi alan adınıza geçtiğinizde bu değeri güncelleyip
# frontend'i yeniden yayınlamanız, ardından QR kodlarını yeniden bastırmanız gerekir.
VITE_PUBLIC_APP_URL=https://PROJE-ADINIZ.vercel.app
